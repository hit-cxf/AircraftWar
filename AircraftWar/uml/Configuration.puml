@startuml
!pragma layout smetana
title 固定预设与自定义配置
enum ConfigKey {
  + label(): String
  + section(): String
  + customEditable(): boolean
}
class GameConfig {
  - values: Map<ConfigKey, Double>
  + {static} from(values): GameConfig
  + parameters(difficulty, level, score): GameParameters
  + bossHp(difficulty, spawnNumber): int
}
class GameConfigStore {
  + {static} defaults(): GameConfig
  + {static} current(): GameConfig
  + {static} save(config): void
  + {static} activate(difficulty): GameConfig
  + {static} active(): GameConfig
}
class SettingsPanel
abstract class Game
class CustomGame
class "game-defaults.properties" as Defaults <<file>>
class "config/custom.properties" as Overrides <<file>>
SettingsPanel ..> ConfigKey : 构建可编辑字段
SettingsPanel ..> GameConfigStore : 读取草稿/校验保存
GameConfig --> ConfigKey
GameConfigStore --> GameConfig : 不可变快照
GameConfigStore ..> Defaults : 固定预设与自定义初值
GameConfigStore ..> Overrides : 仅自定义覆盖，原子保存
Game --> GameConfig : 开局固定快照
Game ..> GameConfigStore : 选择难度
Game <|-- CustomGame
note right of GameConfigStore
  标准模式始终 defaults
  自定义模式读取 current
  保存不改变 active 对局
end note
@enduml
